{
  "skillOverrides": "user-invocable-only",
  "showThinkingSummaries": false,
  "autoScrollEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(curl:*)",
      "Bash(crontab:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(ls:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "type": "shell",
        "command": "bash -c 'if ls \"${REPO_ROOT:-/home/user/Prompt-Guide}/changelogs/\"*.txt 1>/dev/null 2>&1; then cp -u \"${REPO_ROOT:-/home/user/Prompt-Guide}/changelogs/\"*.txt \"/root/바탕화면/Claude-Text/Claude_skills/\" 2>/dev/null; fi'"
      }
    ]
  }
}
